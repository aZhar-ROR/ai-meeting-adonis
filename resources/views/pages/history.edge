@layout('layouts/app')

@section('content')
<style>
  .history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .history-header h1 {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -.02em;
  }
  .count-badge {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 3px 10px;
    border-radius: 99px;
    font-size: 13px;
    font-weight: 600;
    margin-left: 10px;
  }

  /* Stats row */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  @media (max-width: 600px) { .stats-row { grid-template-columns: 1fr; } }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 22px;
    box-shadow: var(--shadow);
  }
  .stat-label { font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
  .stat-value { font-size: 30px; font-weight: 800; letter-spacing: -.03em; color: var(--text); }
  .stat-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }

  /* Grid of meeting cards */
  .meetings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
  }

  .meeting-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
    transition: transform .2s, box-shadow .2s;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: var(--text);
  }
  .meeting-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }

  .meeting-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -.01em;
    line-height: 1.3;
    flex: 1;
  }

  .meeting-date { font-size: 11px; color: var(--muted); margin-top: 4px; }

  .metrics-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .metric-pill {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
  }
  .metric-pill .metric-icon { font-size: 13px; }

  .score-section { display: flex; flex-direction: column; gap: 4px; }
  .score-label { display: flex; justify-content: space-between; font-size: 12px; }
  .score-label span:last-child { font-weight: 700; }

  .card-footer-row { display: flex; justify-content: space-between; align-items: center; }
  .model-tag {
    font-size: 11px;
    color: var(--muted);
    background: var(--surface-2);
    padding: 3px 8px;
    border-radius: 5px;
    font-family: monospace;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 80px 32px;
    color: var(--muted);
  }
  .empty-state .empty-icon { font-size: 56px; margin-bottom: 16px; }
  .empty-state h3 { font-size: 18px; color: var(--text); margin-bottom: 8px; }
  .empty-state p { font-size: 14px; margin-bottom: 24px; }

  .sentiment-badge { white-space: nowrap; }
</style>

<div class="history-header">
  <div>
    <h1>Meeting History <span class="count-badge">{{ meetings.length }}</span></h1>
  </div>
  <a href="/" class="btn btn-primary">
    <span>+</span> New Analysis
  </a>
</div>

@if(meetings.length > 0)
  @let(totalActions = meetings.reduce((s, m) => s + (m.actionItemsCount || 0), 0))
  @let(avgScore = Math.round(meetings.reduce((s, m) => s + (m.overallScore || 0), 0) / meetings.length))
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-label">Total Meetings</div>
      <div class="stat-value">{{ meetings.length }}</div>
      <div class="stat-sub">analyzed transcripts</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Avg Quality Score</div>
      <div class="stat-value">{{ avgScore }}<span style="font-size:16px;font-weight:400;color:var(--muted)">/100</span></div>
      <div class="stat-sub">extraction quality</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Action Items</div>
      <div class="stat-value">{{ totalActions }}</div>
      <div class="stat-sub">across all meetings</div>
    </div>
  </div>

  <div class="meetings-grid">
    @each(meeting in meetings)
    <a href="/history/{{ meeting.id }}" class="meeting-card">
      <div class="card-header-row">
        <div>
          <div class="meeting-title">{{ meeting.title }}</div>
          <div class="meeting-date">
            {{ new Date(meeting.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) }}
          </div>
        </div>
        @if(meeting.sentiment)
        <span class="badge badge-{{ meeting.sentiment }} sentiment-badge">
          {{ meeting.sentiment }}
        </span>
        @end
      </div>

      <div class="metrics-row">
        <div class="metric-pill"><span class="metric-icon"><iconify-icon icon="lucide:check-circle" width="13" height="13"></iconify-icon></span> {{ meeting.decisionsCount }} decisions</div>
        <div class="metric-pill"><span class="metric-icon"><iconify-icon icon="lucide:star" width="13" height="13"></iconify-icon></span> {{ meeting.actionItemsCount }} actions</div>
        <div class="metric-pill"><span class="metric-icon"><iconify-icon icon="lucide:alert-triangle" width="13" height="13"></iconify-icon></span> {{ meeting.questionsCount }} questions</div>
      </div>

      @if(meeting.overallScore)
      <div class="score-section">
        <div class="score-label">
          <span style="color:var(--muted);font-size:12px">Quality Score</span>
          <span>{{ meeting.overallScore }}/100</span>
        </div>
        <div class="score-bar-wrap">
          <div class="score-bar" style="width: {{ meeting.overallScore }}%"></div>
        </div>
      </div>
      @end

      <div class="card-footer-row">
        <span class="model-tag">{{ meeting.model }}</span>
        <span style="font-size:13px;color:var(--accent);font-weight:600;display:inline-flex;align-items:center;gap:4px;">View Details <iconify-icon icon="lucide:arrow-right" width="13" height="13"></iconify-icon></span>
      </div>
    </a>
    @end
  </div>

@else
  <div class="card">
    <div class="empty-state">
      <div class="empty-icon"><iconify-icon icon="lucide:clock" width="56" height="56"></iconify-icon></div>
      <h3>No meetings analyzed yet</h3>
      <p>Paste a meeting transcript to get started with AI-powered extraction.</p>
      <a href="/" class="btn btn-primary">Analyze your first meeting</a>
    </div>
  </div>
@end

@end
