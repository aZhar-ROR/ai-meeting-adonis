@layout('layouts/app')

@section('content')
<style>
  /* ── Hero ── */
  .hero {
    padding: 28px 0 32px;
  }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--accent-light);
    border: 1px solid rgba(56,189,248,.25);
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 99px;
    margin-bottom: 18px;
  }
  .hero h1 {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -.03em;
    color: var(--text);
    margin-bottom: 10px;
    line-height: 1.2;
    white-space: nowrap;
  }
  .hero h1 span {
    background: linear-gradient(90deg, var(--accent), #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
    white-space: nowrap;
  }

  /* ── Transcript panel ── */
  .transcript-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .transcript-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  .transcript-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .toolbar-actions { display: flex; gap: 6px; }
  .tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    background: var(--surface-2);
    border: 1px solid var(--border-2);
    color: var(--muted);
    transition: background .15s, color .15s, border-color .15s;
  }
  .tool-btn:hover { background: var(--surface-3); color: var(--text); border-color: var(--muted); }

  .transcript-body { padding: 0; flex: 1; }
  .transcript-area {
    width: 100%;
    min-height: 340px;
    padding: 18px 20px;
    background: transparent;
    border: none;
    color: var(--text-dim);
    font-size: 13px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
    line-height: 1.7;
    resize: vertical;
    outline: none;
  }
  .transcript-area::placeholder { color: var(--muted); opacity: .6; }

  .transcript-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
  }
  .char-count { font-size: 11px; color: var(--muted); }

  /* Submit */
  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 28px;
    background: var(--accent);
    color: #05090f;
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-family: inherit;
    letter-spacing: -.01em;
    transition: background .15s, box-shadow .15s, transform .1s;
    white-space: nowrap;
  }
  .submit-btn:hover {
    background: var(--accent-hover);
    box-shadow: 0 0 0 1px rgba(56,189,248,.4), 0 4px 20px rgba(56,189,248,.25);
  }
  .submit-btn:active { transform: translateY(1px); }
  .submit-btn:disabled {
    opacity: .5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* ── Analyzing overlay ── */
  #analyzingOverlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(9,9,15,.8);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  #analyzingOverlay.active { display: flex; }
  .spinner-ring {
    width: 48px;
    height: 48px;
    border: 3px solid rgba(56,189,248,.2);
    border-top-color: #38bdf8;
    border-radius: 50%;
    animation: spin .8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .overlay-label {
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -.01em;
  }
  .overlay-sub {
    font-size: 12px;
    color: rgba(255,255,255,.45);
  }
</style>

<div class="hero">
  <div class="hero-chip">
    <iconify-icon icon="lucide:zap" width="11" height="11"></iconify-icon>
    AI-Powered Analysis
  </div>
  <h1>Turn meetings into <span>structured insights</span></h1>
  <p>Paste any meeting transcript and extract decisions, action items, open questions and follow-ups — instantly.</p>
</div>

@if(flashMessages.has('error'))
<div class="alert alert-error" style="margin-bottom:20px;flex-direction:column;align-items:flex-start;gap:8px;">
  <div style="display:flex;align-items:center;gap:8px;">
    <iconify-icon icon="lucide:alert-triangle" width="16" height="16"></iconify-icon>
    <span>{{ flashMessages.get('error') }}</span>
  </div>
  @if(flashMessages.get('error') && flashMessages.get('error').includes('starting up'))
  <div style="font-size:13px;color:var(--muted);padding-left:24px;">
    👉 Open <a href="https://ai-meeting-assistant-service.onrender.com/health" target="_blank" style="color:var(--accent);text-decoration:underline;">this link</a> and wait until it shows <code style="background:var(--surface-3);padding:1px 6px;border-radius:4px;font-size:12px;">{"status":"ok"}</code> — then try again.
  </div>
  @end
</div>
@end

<form action="/analyze" method="POST">
  {{ csrfField() }}
  <input type="hidden" name="model" value="gemini-3.8-flash" />
  <input type="hidden" name="prompt_version" value="3" />

    <!-- Transcript panel -->
    <div class="transcript-panel">
      <div class="transcript-toolbar">
        <div class="transcript-title">
          <iconify-icon icon="lucide:file-text" width="15" height="15" style="color:var(--accent)"></iconify-icon>
          Meeting Transcript
        </div>
        <div class="toolbar-actions">
          <button type="button" class="tool-btn" onclick="loadSample()">
            <iconify-icon icon="lucide:download" width="12" height="12"></iconify-icon> Load sample
          </button>
          <button type="button" class="tool-btn" onclick="clearTranscript()">
            <iconify-icon icon="lucide:x" width="12" height="12"></iconify-icon> Clear
          </button>
        </div>
      </div>

      <div class="transcript-body">
        <textarea
          id="transcript"
          name="transcript"
          class="transcript-area"
          placeholder="Paste your meeting transcript here...

Example:
John: Let's start the Q3 planning meeting.
Sarah: I think we should prioritize the mobile app redesign.
John: Agreed, we'll go with the new design system..."
          oninput="updateCount()"
        ></textarea>
      </div>

      <div class="transcript-footer">
        <span class="char-count" id="charCount">0 characters</span>
        <button type="submit" class="submit-btn">
          <iconify-icon icon="lucide:brain" width="16" height="16"></iconify-icon>
          Analyze Meeting
        </button>
      </div>
    </div>

</form>

<div id="analyzingOverlay">
  <div class="spinner-ring"></div>
  <div class="overlay-label">Analyzing with Gemini…</div>
  <div class="overlay-sub">This may take 10–30 seconds</div>
</div>

<template id="sample-transcript">Sprint 24 Debrief | FS Kriyam — November 8, 2026

Attendees: Shreyas R (Project Manager), Azhar (Developer), Asif (Developer), Sulagna (Developer), Soumik (Developer)

Shreyas: Alright everyone, let's close out Sprint 24. Good sprint overall but we have some things to carry forward. Let's go through it quickly.

Azhar: From my side, the authentication module is done and merged. All test cases passing. But the profile settings page still has an issue with image upload — it's throwing a 413 error on files above 2MB.

Shreyas: Okay, let's fix that this sprint. Azhar, can you own the file upload fix and get it done by November 11th?

Azhar: Yes, I'll handle it.

Asif: The notification service is deployed. Real-time push notifications are working on web but on mobile there's a delay of about 8 to 10 seconds. I think it's a socket reconnection issue.

Shreyas: That delay is not acceptable for the client demo. Asif, please prioritize fixing the mobile notification delay. Can you get it resolved by November 12th?

Asif: I'll investigate today and fix it. November 12th works.

Sulagna: The reporting dashboard UI is almost complete. I've finished the charts and the filter section. The only pending part is the export to PDF feature — I need Soumik's API endpoint for that.

Soumik: The export endpoint is ready actually, I was just waiting to confirm the response format with Sulagna.

Sulagna: Let's sync after this call and finalise it. I can have the full dashboard done by November 13th once we align.

Shreyas: Good. Sulagna owns the dashboard completion by November 13th. Soumik, please support Sulagna on the export API today itself.

Soumik: Done, I'll share the API docs right after this meeting.

Shreyas: Soumik, what else is pending on your end?

Soumik: The search and filter functionality for the project list is pending. I started it but it's about 60% done. I can complete it by November 14th.

Shreyas: That works, just make sure it's in staging before the client demo on November 18th.

Azhar: One thing I want to flag — we don't have proper error boundary handling on the frontend. If any API fails, the whole page crashes instead of showing a fallback. We should fix that.

Shreyas: Agreed, we'll take that up. Azhar, add that to Sprint 25 scope and we'll plan it properly.

Sulagna: Also open question — are we going with server-side export or client-side for the PDF feature? It affects how I build the UI.

Soumik: Server-side is cleaner, I already have the endpoint generating the PDF. Let's go with that.

Shreyas: Decided — PDF export will be server-side. Let's document that.

Shreyas: Alright, wrapping up. Key decisions: server-side PDF export confirmed, mobile notification delay is a P1 fix. Action items — Azhar fixes file upload by November 11th, Asif fixes mobile notifications by November 12th, Sulagna completes dashboard by November 13th, Soumik completes search and filter by November 14th. Client demo is November 18th — everything must be in staging by November 16th. Let's go.</template>

<script>
function loadSample() {
  const tpl = document.getElementById('sample-transcript');
  document.getElementById('transcript').value = tpl.innerHTML.trim();
  updateCount();
}
function clearTranscript() {
  document.getElementById('transcript').value = '';
  updateCount();
}
function updateCount() {
  const len = document.getElementById('transcript').value.length;
  document.getElementById('charCount').textContent = len.toLocaleString() + ' characters';
}

const overlay = document.getElementById('analyzingOverlay');
const submitBtn = document.querySelector('form[action="/analyze"] button[type="submit"]');

document.querySelector('form[action="/analyze"]').addEventListener('submit', function () {
  const val = document.getElementById('transcript').value.trim();
  if (!val) return;
  overlay.classList.add('active');
  submitBtn.disabled = true;
  submitBtn.innerHTML = '<div style="width:14px;height:14px;border:2px solid rgba(0,0,0,.3);border-top-color:#000;border-radius:50%;animation:spin .8s linear infinite;flex-shrink:0"></div>&nbsp;Analyzing…';
});

// Reset overlay when browser restores page from bfcache (back/forward navigation)
window.addEventListener('pageshow', function (e) {
  overlay.classList.remove('active');
  submitBtn.disabled = false;
  submitBtn.innerHTML = '<iconify-icon icon="lucide:brain" width="16" height="16"></iconify-icon> Analyze Meeting';
});
</script>
@end
