  .member-row:last-child { border-bottom: none; }
  .member-info { display: flex; align-items: center; gap: 12px; }
  .avatar { width: 34px; height: 34px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #fff; }
  .avatar-purple { background: #7c3aed; }
  .avatar-blue { background: #2563eb; }
  .avatar-green { background: #059669; }
  .badge-role-admin { background: rgba(167,139,250,.12); color: #a78bfa; border: 1px solid rgba(167,139,250,.2); }
  .badge-role-manager { background: rgba(96,165,250,.12); color: #60a5fa; border: 1px solid rgba(96,165,250,.2); }
  .badge-role-developer { background: rgba(52,211,153,.12); color: #34d399; border: 1px solid rgba(52,211,153,.2); }
  .badge-active { background: rgba(52,211,153,.12); color: #34d399; border: 1px solid rgba(52,211,153,.2); }
  .badge-archived { background: var(--surface-2); color: var(--muted); border: 1px solid var(--border); }
  .badge-pending { background: rgba(251,191,36,.12); color: #fbbf24; border: 1px solid rgba(251,191,36,.2); }
  .badge-in_progress { background: rgba(96,165,250,.12); color: #60a5fa; border: 1px solid rgba(96,165,250,.2); }
  .badge-done { background: rgba(52,211,153,.12); color: #34d399; border: 1px solid rgba(52,211,153,.2); }
  .badge-low { background: var(--surface-2); color: var(--muted); border: 1px solid var(--border); }
  .badge-medium { background: rgba(251,191,36,.12); color: #fbbf24; border: 1px solid rgba(251,191,36,.2); }
  .badge-high { background: rgba(248,113,113,.12); color: #f87171; border: 1px solid rgba(248,113,113,.2); }
  table { width: 100%; border-collapse: collapse; }
  th { padding: 10px 12px; text-align: left; font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  td { padding: 12px; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--surface-2); }
  .add-member-form { display: flex; gap: 10px; margin-top: 16px; }
  .add-member-form select { flex: 1; }
  .btn-danger { background: rgba(248,113,113,.08); color: var(--danger); border: 1px solid rgba(248,113,113,.2); }
  .btn-danger:hover { background: rgba(248,113,113,.15); border-color: rgba(248,113,113,.35); }
  .empty-msg { color: var(--muted); font-size: 13px; font-style: italic; }
  .meeting-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .meeting-row:last-child { border-bottom: none; }
  .meeting-link { text-decoration: none; color: var(--text); font-weight: 500; font-size: 14px; }
