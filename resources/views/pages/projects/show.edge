  <div class="stat-box">
    <div class="stat-value">{{ project.members.length }}</div>
    <div class="stat-label">Members</div>
  </div>
  <div class="stat-box">
    <div class="stat-value">{{ project.meetings.length }}</div>
    <div class="stat-label">Meetings</div>
  </div>
</div>

<!-- Members -->
<div class="section-card">
  <div class="section-card-header">
    <span class="section-card-title"><iconify-icon icon="lucide:users" width="16" height="16"></iconify-icon> Members</span>
  </div>
  <div class="section-card-body">
    @if(project.members.length === 0)
      <p class="empty-msg">No members yet. Add team members below.</p>
    @else
      @each(member in project.members)
        <div class="member-row">
          <div class="member-info">
            @if(member.role === 'admin')
              <div class="avatar avatar-purple">{{ member.avatarInitials || member.name.substring(0,2).toUpperCase() }}</div>
              <span class="fw-600">{{ member.name }}</span>
              <span class="badge badge-role-admin">Admin</span>
            @elseif(member.role === 'manager')
              <div class="avatar avatar-blue">{{ member.avatarInitials || member.name.substring(0,2).toUpperCase() }}</div>
              <span class="fw-600">{{ member.name }}</span>
              <span class="badge badge-role-manager">Manager</span>
            @else
              <div class="avatar avatar-green">{{ member.avatarInitials || member.name.substring(0,2).toUpperCase() }}</div>
              <span class="fw-600">{{ member.name }}</span>
              <span class="badge badge-role-developer">Developer</span>
            @end
          </div>
          <button class="btn btn-sm btn-danger" onclick="removeMember({{ project.id }}, {{ member.id }})">Remove</button>
        </div>
      @end
    @end

    @if(nonMembers.length > 0)
      <form method="POST" action="/projects/{{ project.id }}/members" class="add-member-form">
        {{ csrfField() }}
        <select name="userId" class="form-control">
          <option value="">— Select user to add —</option>
          @each(user in nonMembers)
            <option value="{{ user.id }}">{{ user.name }}</option>
          @end
        </select>
        <button type="submit" class="btn btn-secondary btn-sm">Add Member</button>
      </form>
    @end
  </div>
</div>

<!-- Board Statuses -->
<div class="section-card">
  <div class="section-card-header">
    <span class="section-card-title"><iconify-icon icon="lucide:columns" width="16" height="16"></iconify-icon> Board Statuses</span>
    <span class="text-muted text-xs">Defines Kanban columns for this project's tasks</span>
  </div>
  <div class="section-card-body">
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;" id="status-chips">
      @each(st in project.statuses)
        <div style="display:flex;align-items:center;gap:6px;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:6px 12px;">
          <span style="width:10px;height:10px;border-radius:50%;background:{{ st.color }};display:inline-block;flex-shrink:0;"></span>
          <span style="font-size:13px;font-weight:500;">{{ st.name }}</span>
          <span style="font-size:10px;color:var(--muted);">({{ st.slug }})</span>
          @if(project.statuses.length > 1)
            <button onclick="removeStatus({{ project.id }}, {{ st.id }})" style="background:none;border:none;color:var(--muted);cursor:pointer;padding:0 2px;line-height:1;display:flex;align-items:center;" title="Remove status"><iconify-icon icon="lucide:x" width="12" height="12"></iconify-icon></button>
          @end
        </div>
      @end
    </div>

    <form method="POST" action="/projects/{{ project.id }}/statuses" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
      {{ csrfField() }}
      <div>
        <label style="font-size:12px;color:var(--muted);display:block;margin-bottom:4px;">Status Name</label>
        <input type="text" name="name" placeholder="e.g. Review" class="form-control" style="width:160px;" required />
      </div>
      <div>
        <label style="font-size:12px;color:var(--muted);display:block;margin-bottom:4px;">Color</label>
        <input type="color" name="color" value="#6366f1" style="width:40px;height:36px;border:1px solid var(--border);border-radius:6px;cursor:pointer;padding:2px;" />
      </div>
      <button type="submit" class="btn btn-secondary btn-sm">+ Add Status</button>
    </form>
  </div>
</div>

<!-- Tasks -->
<div class="section-card">
  <div class="section-card-header">
    <span class="section-card-title"><iconify-icon icon="lucide:check-square" width="16" height="16"></iconify-icon> Tasks</span>
    <a href="/tasks/create?project_id={{ project.id }}" class="btn btn-sm btn-secondary">+ Add Task</a>
  </div>
  <div class="section-card-body" style="padding:0;">
    @if(project.tasks.length === 0)
      <p class="empty-msg" style="padding:20px 24px;">No tasks yet.</p>
    @else
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Assignee</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Due</th>
          </tr>
        </thead>
        <tbody>
          @each(task in project.tasks)
            <tr>
              <td><a href="/tasks/{{ task.id }}" style="text-decoration:none;color:var(--text);font-weight:500;">{{ task.title }}</a></td>
              <td class="text-muted text-sm">{{ task.assignee ? task.assignee.name : 'Unassigned' }}</td>
              <td><span class="badge badge-{{ task.status }}">{{ task.status.replace('_', ' ') }}</span></td>
              <td><span class="badge badge-{{ task.priority }}">{{ task.priority }}</span></td>
              <td class="text-muted text-sm">{{ task.dueDate ? task.dueDate.toFormat('MMM d, yyyy') : '—' }}</td>
            </tr>
          @end
        </tbody>
      </table>
    @end
  </div>
</div>

<!-- Meetings -->
<div class="section-card">
  <div class="section-card-header">
    <span class="section-card-title"><iconify-icon icon="lucide:message-square" width="16" height="16"></iconify-icon> Meetings</span>
  </div>
  <div class="section-card-body">
    @if(project.meetings.length === 0)
      <p class="empty-msg">No meetings linked to this project.</p>
    @else
      @each(meeting in project.meetings)
        <div class="meeting-row">
          <a href="/history/{{ meeting.id }}" class="meeting-link">{{ meeting.title }}</a>
          <span class="text-muted text-xs">{{ meeting.createdAt.toFormat('MMM d, yyyy') }}</span>
        </div>
      @end
    @end
  </div>
</div>

<form id="delete-project-form" method="POST" style="display:none;">
  {{ csrfField() }}
  <input type="hidden" name="_method" value="DELETE" />
</form>

<form id="remove-member-form" method="POST" style="display:none;">
  {{ csrfField() }}
  <input type="hidden" name="_method" value="DELETE" />
</form>

<form id="remove-status-form" method="POST" style="display:none;">
  {{ csrfField() }}
  <input type="hidden" name="_method" value="DELETE" />
</form>

<script>
  function deleteProject(id) {
    if (!confirm('Delete this project? This cannot be undone.')) return
    const form = document.getElementById('delete-project-form')
    form.action = '/projects/' + id + '?_method=DELETE'
    form.submit()
  }
  function removeMember(projectId, userId) {
    if (!confirm('Remove this member from the project?')) return
    const form = document.getElementById('remove-member-form')
    form.action = '/projects/' + projectId + '/members/' + userId + '?_method=DELETE'
    form.submit()
  }
  function removeStatus(projectId, statusId) {
    if (!confirm('Remove this status? Tasks with this status will remain but the column will disappear from the board.')) return
    const form = document.getElementById('remove-status-form')
    form.action = '/projects/' + projectId + '/statuses/' + statusId + '?_method=DELETE'
    form.submit()
  }
</script>
@end
