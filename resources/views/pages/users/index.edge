@layout('layouts/app')

@section('content')
<style>
  .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }
  .page-title { font-size: 22px; font-weight: 700; }
  .table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  table { width: 100%; border-collapse: collapse; }
  th { padding: 12px 16px; text-align: left; font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  td { padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 14px; vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--surface-2); }
  .avatar { width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff; }
  .avatar-purple { background: #7c3aed; }
  .avatar-blue { background: #2563eb; }
  .avatar-green { background: #059669; }
  .avatar-gray { background: #64748b; }
  .user-info { display: flex; align-items: center; gap: 12px; }
  .badge-role-admin { background: rgba(167,139,250,.12); color: #a78bfa; border: 1px solid rgba(167,139,250,.2); }
  .badge-role-manager { background: rgba(96,165,250,.12); color: #60a5fa; border: 1px solid rgba(96,165,250,.2); }
  .badge-role-developer { background: rgba(52,211,153,.12); color: #34d399; border: 1px solid rgba(52,211,153,.2); }
  .btn-danger { background: rgba(248,113,113,.08); color: var(--danger); border: 1px solid rgba(248,113,113,.2); }
  .btn-danger:hover { background: rgba(248,113,113,.15); border-color: rgba(248,113,113,.35); }
  .empty-state { text-align: center; padding: 60px 24px; color: var(--muted); }
  .empty-state .empty-icon { font-size: 48px; margin-bottom: 16px; }
</style>

<div class="page-header">
  <div>
    <h1 class="page-title">Users</h1>
    <p class="text-muted text-sm mt-8">Manage team members and their roles</p>
  </div>
  <a href="/users/create" class="btn btn-primary">+ New User</a>
</div>

@if(flashMessages.has('success'))
  <div class="alert alert-success">
    <iconify-icon icon="lucide:check-circle" width="16" height="16"></iconify-icon> {{ flashMessages.get('success') }}
  </div>
@end

@if(flashMessages.has('error'))
  <div class="alert alert-error">
    <span class="alert-icon"><iconify-icon icon="lucide:alert-triangle" width="16" height="16"></iconify-icon></span>
    {{ flashMessages.get('error') }}
  </div>
@end

@if(users.length === 0)
  <div class="table-wrap">
    <div class="empty-state">
      <div class="empty-icon"><iconify-icon icon="lucide:users" width="48" height="48"></iconify-icon></div>
      <p class="fw-600 mb-8">No users yet</p>
      <p class="text-sm">Create your first team member to get started.</p>
      <a href="/users/create" class="btn btn-primary mt-16">Add User</a>
    </div>
  </div>
@else
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Email</th>
          <th>Role</th>
          <th>Tasks</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @each(user in users)
          <tr>
            <td>
              <div class="user-info">
                @if(user.role === 'admin')
                  <div class="avatar avatar-purple">{{ user.avatarInitials || user.name.substring(0,2).toUpperCase() }}</div>
                @elseif(user.role === 'manager')
                  <div class="avatar avatar-blue">{{ user.avatarInitials || user.name.substring(0,2).toUpperCase() }}</div>
                @else
                  <div class="avatar avatar-green">{{ user.avatarInitials || user.name.substring(0,2).toUpperCase() }}</div>
                @end
                <span class="fw-600">{{ user.name }}</span>
              </div>
            </td>
            <td class="text-muted">{{ user.email }}</td>
            <td>
              @if(user.role === 'admin')
                <span class="badge badge-role-admin">Admin</span>
              @elseif(user.role === 'manager')
                <span class="badge badge-role-manager">Manager</span>
              @else
                <span class="badge badge-role-developer">Developer</span>
              @end
            </td>
            <td class="text-muted">{{ user.$extras.tasks_count || 0 }}</td>
            <td>
              <button class="btn btn-sm btn-danger" onclick="deleteUser({{ user.id }})">Delete</button>
            </td>
          </tr>
        @end
      </tbody>
    </table>
  </div>
@end

<form id="delete-form" method="POST" style="display:none;">
  {{ csrfField() }}
  <input type="hidden" name="_method" value="DELETE" />
</form>

<script>
  function deleteUser(id) {
    if (!confirm('Are you sure you want to delete this user?')) return
    const form = document.getElementById('delete-form')
    form.action = '/users/' + id + '?_method=DELETE'
    form.submit()
  }
</script>
@end
